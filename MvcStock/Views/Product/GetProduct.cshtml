@model MvcStock.Models.Entity.Tbl_Products
@{
    ViewBag.Title = "GetProduct";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


@using (Html.BeginForm("Update", "Product", FormMethod.Post))
{
<div class="form-group">
    @Html.Label("Product ID")
    @Html.TextBoxFor(m => m.ProductID, new { @class = "form-control" })
    <br />

    @Html.Label("Product Name")
    @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control" })
    <br />

    @Html.Label("Brand Name")
    @Html.TextBoxFor(m => m.BrandName, new { @class = "form-control" })
    <br />

    @Html.Label("Product Category")
    @*@Html.TextBoxFor(m => m.ProductCategory, new { @class = "form-control" })*@
    @Html.DropDownListFor(m => m.Tbl_Categories.CategoryID, (List<SelectListItem>)ViewBag.val, new { @class = "form-control" })
    <br />
    @Html.Label("Price")
    @Html.TextBoxFor(m => m.Price, new { @class = "form-control" })
    <br />
    @Html.Label("Stock")
    @Html.TextBoxFor(m => m.Stock, new { @class = "form-control" })
    <br />
</div>
    <div>
        <button class="btn btn-warning">Update Product</button>
    </div>
}
